# ============================================
# AIRTABLE CONFIGURATION
# ============================================
# Get these from your Airtable account:
# 1. Go to https://airtable.com/create/tokens
# 2. Create a personal access token with data.records:read and data.records:write scopes
# 3. Your Base ID can be found in the URL when you open your base
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_PAT=your_airtable_personal_access_token_here

# ============================================
# SMTP EMAIL CONFIGURATION
# ============================================
# For Gmail:
# 1. Enable 2-factor authentication
# 2. Generate an "App Password" from Google Account settings
# 3. Use that app password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sebinsajiabraham@gmail.com
SMTP_PASS=xwymfvrypyhyojlj

# Email addresses for sending/receiving order notifications
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_TO_EMAIL=orders@yourcompany.com

# ============================================
# META WHATSAPP BUSINESS API CONFIGURATION
# ============================================
# Get these from Meta Business:
# 1. Go to https://developers.facebook.com/
# 2. Create a business app and enable WhatsApp Business API
# 3. Get your Access Token from the WhatsApp settings
# 4. Get your Phone Number ID from the WhatsApp Business Account

# Your Meta Business WhatsApp Access Token
META_WHATSAPP_TOKEN=your_meta_whatsapp_access_token_here

# Your WhatsApp Business Phone Number ID (not your actual phone number)
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# The recipient phone number for order notifications (in international format without + or spaces)
# Example: 447700900000 for UK number
META_WHATSAPP_RECIPIENT=447700900000

# ============================================
# NEXT.JS CONFIGURATION (Optional)
# ============================================
# These are public and can be accessed on the client side
NEXT_PUBLIC_APP_NAME="Shore to Door"
